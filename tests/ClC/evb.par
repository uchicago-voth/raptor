::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::


: is refining states
#ifdef EVB3
  0
#endif

#ifdef EVB2
  1
#endif

#ifdef WAT

[state_search.start.H3O]

  : host;  target;  client;   shell limit;   distance limit;    reaction pair;  reaction path
  : H->OW
    2      H2O         1            3                2.5        H3O_H2O           1
    3      H2O         1            3                2.5        H3O_H2O           2
    4      H2O         1            3                2.5        H3O_H2O           3

  #ifdef GL2
  : H->OC
    2      GL2-D       5            3                2.5        H3O_GL2-D         1
    3      GL2-D       5            3                2.5        H3O_GL2-D         2
    4      GL2-D       5            3                2.5        H3O_GL2-D         3
    2      GL2-D       6            3                2.5        H3O_GL2-D         4
    3      GL2-D       6            3                2.5        H3O_GL2-D         5
    4      GL2-D       6            3                2.5        H3O_GL2-D         6
  #endif

[state_search.end]

[state_search.start.H2O]

  : host;  target;  client;   shell limit;   distance limit;    reaction pair;  reaction path
  : H->OW
    2      H2O         1            3                2.5        H3O_H2O           2
    3      H2O         1            3                2.5        H3O_H2O           3

  #ifdef GL2
  : H->OC
    2      GL2-D       5            3                2.5        H3O_GL2-D         2
    3      GL2-D       5            3                2.5        H3O_GL2-D         3
    2      GL2-D       6            3                2.5        H3O_GL2-D         5
    3      GL2-D       6            3                2.5        H3O_GL2-D         6
  #endif

[state_search.end]

#endif

#ifdef GL2

[state_search.start.GL2-P]
     7     H2O         1            3                2.5        GL2-P_H2O         1
[state_search.end]

[state_search.start.GL2-D]
[state_search.end]

