[segment.off_diagonal]
::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

::::::::::::::::::::::::::::::::::::::
: for pt of H3O->H2O
::::::::::::::::::::::::::::::::::::::

#ifdef WAT

[off_diagonal.start.H3O_H2O]

PT  : Use the PT coupling

: Geometry part

 : Geometry part

  : atom index
 1  1              : evb_index of DONOR atom (should be in molecule A)
 2  1              : evb_index of ACCEPT atom (should be in molecule B)
 2  2              : evb_index of HYDROGEN atom (should be in molecule B)

  : A_Rq Type : A(R,q) = f(R) * g(q)
 1 : 1-symmetric; 2-asymmetric

  #ifdef EVB3

  : parameters
 1.783170   : g
 0.158858   : P
 5.163036   : k
 2.856269   : D_oo
 6.421623   : b
 2.923805   : R0_oo
 7.535474   : P'
 7.051027   : a
 1.800000   : r0_oo

 : Potential part
   -21.064268        : vij_const, in kcal/mol
     3 0.5             : if contains Vij_ex part (1 = with kspace, 2 = debye, 3 = wolf, 4 = cgis, 5 = user-defined); 3 and 4 needs a kappa value

  : exchanged charge
   H2O  H3O : Types of molecule_A (Water) and molecule_B (Hydrolium)

   -0.0895456
    0.0252683
    0.0252683
   -0.0895456
    0.0780180
    0.0252683
    0.0252683

  #endif

  #ifdef EVB2

  : parameters
   1.85           : gamma
   0.27           : P
   11.5           : k
   2.875          : D_oo
   4.50           : beta
   3.14           : R0_oo
   10.0           : P'
   12.0           : alpha
   1.88           : r0_oo

 : Potential part
   -32.419        : vij_const, in kcal/mol
     1                : if contains Vij_ex part

  : exchanged charge
   H20  H30 : Types of molecule_A (Water) and molecule_B (Hydrolium)

   -0.116725
    0.04669
    0.04669
   -0.116725
    0.04669
    0.04669
    0.04669

  #endif

[off_diagonal.end]

#endif

: ----------------------------------------------------------------------------
: ----------------------------------------------------------------------------

#ifdef GL2

[off_diagonal.start.GL2-P_H2O]

  DA_Gaussian  : Type of coupling: Proton Transfer
  1 6  : evb_index of DONOR atom (should be in molecule A)
  2 2  : evb_index of HYDROGEN atom (should be in molecule B)

          : parameters
-35.686750    :
1.291340      :  C1 * EXP[-C2 * (R - C3)]
1.598104      :

 : Potential part
    1.0        : vij_const, in kcal/mol
    0.0        : if contains Vij_ex part

[off_diagonal.end]

