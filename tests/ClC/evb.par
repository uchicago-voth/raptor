  2 7  : evb_index of HYDROGEN atom (should be in molecule B)

          : parameters
-35.686750    :
1.291340      :  C1 * EXP[-C2 * (R - C3)]
1.598104      :

 : Potential part
    1.0        : vij_const, in kcal/mol
    0.0        : if contains Vij_ex part

[off_diagonal.end]

#endif

[segment.end]

